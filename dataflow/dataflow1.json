{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "getdummyempcsv",
					"description": "Import data from dummyEmp csv"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "finaldatasink",
					"description": "Final data of female employees"
				}
			],
			"transformations": [
				{
					"name": "genderselectionfilter",
					"description": "Only Females selected"
				},
				{
					"name": "salarysort",
					"description": "Sort on the basis of salary"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as string,",
				"          Name as string,",
				"          Dept as string,",
				"          Position as string,",
				"          Salary as string,",
				"          Gender as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> getdummyempcsv",
				"getdummyempcsv filter(Gender==\"F\") ~> genderselectionfilter",
				"genderselectionfilter sort(desc(Salary, true),",
				"     partitionLevel: true) ~> salarysort",
				"salarysort sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> finaldatasink"
			]
		}
	}
}